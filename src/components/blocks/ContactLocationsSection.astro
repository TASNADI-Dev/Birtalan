---
import type { ContactLocation } from '../../lib/sanity/queries';

interface Props {
  locations?: ContactLocation[] | null;
}

const { locations } = Astro.props;
const items = (locations ?? []).filter(
  (location) => location.name?.trim() && location.address?.trim(),
);

const addressClass =
  'whitespace-pre-line text-[0.875rem] leading-[1.5] tracking-[-0.01em] text-mako-700';
const addressLinkClass = `${addressClass} transition-colors duration-200 hover:text-highlight`;
---

{
  items.length > 0 && (
    <section class="mx-auto w-full max-w-[1440px] px-6 pt-12 pb-20 max-md:pt-8 max-md:pb-12">
      <div class="flex flex-col gap-8 max-md:gap-6">
        <h2
          class="font-sans text-[2.5rem] font-light leading-[1.1] tracking-[-0.03em] text-mandalay-950 max-md:text-[2rem]"
        >
          Helyszín
        </h2>

        <ul class="grid grid-cols-2 gap-x-16 gap-y-8 max-md:grid-cols-1 max-md:gap-6">
          {items.map((location) => (
            <li class="flex items-start gap-3 text-mandalay-950">
              <svg
                class="size-[2.5rem] shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <div class="flex min-w-0 flex-col gap-2">
                <h3 class="font-sans text-[1.125rem] font-normal leading-[1.3] tracking-[-0.02em]">
                  {location.name}
                </h3>
                {location.mapsUrl ? (
                  <a
                    href={location.mapsUrl}
                    class={addressLinkClass}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {location.address}
                  </a>
                ) : (
                  <p class={addressClass}>{location.address}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
