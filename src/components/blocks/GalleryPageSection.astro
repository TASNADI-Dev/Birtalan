---
import { buildImageUrl } from '../../lib/sanity/image';
import type { GalleryPageTab } from '../../lib/sanity/queries';

interface Props {
	tabs: GalleryPageTab[];
}

const { tabs } = Astro.props;
---

<section
	class="mx-auto w-full max-w-[1440px] px-6 py-12 md:py-20"
	data-gallery-tabs
>
	<div class="flex flex-col items-center gap-8 md:gap-12">
		<h1
			class="text-center font-sans text-[3.5rem] font-light leading-[1.1] tracking-[-0.03em] text-mandalay-950 max-md:text-[2.5rem]"
		>
			Galéria
		</h1>

		{
			tabs.length > 0 && (
				<div
					role="tablist"
					aria-label="Galéria kategóriák"
					data-gallery-tablist
					class="flex max-w-full flex-wrap items-center justify-center gap-x-8 gap-y-4 max-md:justify-start max-md:overflow-x-auto max-md:flex-nowrap max-md:pb-1"
				>
					{tabs.map((tab, index) => (
						<button
							type="button"
							role="tab"
							id={`gallery-tab-${tab.slug}`}
							aria-controls={`gallery-panel-${tab.slug}`}
							aria-selected={index === 0}
							tabindex={index === 0 ? 0 : -1}
							data-gallery-tab
							class="shrink-0 cursor-pointer border-b-2 border-transparent px-1 pb-2 text-[0.875rem] leading-[1.5] tracking-[-0.01em] text-mako-600 transition-colors duration-200 hover:text-mandalay-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mandalay-400 aria-selected:border-highlight aria-selected:text-mandalay-950 max-md:whitespace-nowrap"
						>
							{tab.title}
						</button>
					))}
				</div>
			)
		}

		<div class="w-full">
			{
				tabs.map((tab, index) => (
					<div
						role="tabpanel"
						id={`gallery-panel-${tab.slug}`}
						aria-labelledby={`gallery-tab-${tab.slug}`}
						data-gallery-panel
						hidden={index !== 0}
						class="w-full"
					>
						{
							tab.images.length > 0 && (
								<div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
									{tab.images.map((item) => {
										const imageSrc = item.imageUrl
											? buildImageUrl(item.imageUrl, {
													width: 600,
													height: 400,
												})
											: (item.fallbackImageUrl ?? '');

										if (!imageSrc) return null;

										return (
											<div class="relative w-full overflow-hidden rounded-[12px]">
												<img
													src={imageSrc}
													alt={item.alt ?? ''}
													width="600"
													height="400"
													loading="lazy"
													decoding="async"
													class="aspect-[3/2] w-full object-cover"
												/>
											</div>
										);
									})}
								</div>
							)
						}
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	import { initGalleryTabs } from '../../scripts/gallery-tabs';

	initGalleryTabs();
</script>
