---
import Button from '../Button.astro';
import { buildImageUrl } from '../../lib/sanity/image';
import type { GallerySection as GallerySectionData } from '../../lib/sanity/queries';

interface Props {
  section: GallerySectionData;
}

const { section } = Astro.props;
---

<section class="mx-auto w-full max-w-[1440px] px-6 py-12 md:py-20">
  <div class="flex flex-col gap-8 md:gap-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2
        class="text-left font-sans text-[2.5rem] font-light leading-[1.1] tracking-[-0.03em] text-mandalay-950 max-md:text-[2rem]"
      >
        {section.heading}
      </h2>
      <Button variant="text-only" href="#" arrow>
        További képek
      </Button>
    </div>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {
        section.images.map((item) => {
          const imageSrc = item.imageUrl
            ? buildImageUrl(item.imageUrl, { width: 600, height: 400 })
            : item.fallbackImageUrl ?? '';

          return (
            <div class="relative w-full overflow-hidden rounded-[12px]">
              <img
                src={imageSrc}
                alt={item.alt}
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
                class="aspect-[3/2] w-full object-cover"
              />
            </div>
          );
        })
      }
    </div>
  </div>
</section>
