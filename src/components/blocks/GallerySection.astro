---
import Button from '../Button.astro';
import { buildImageUrl } from '../../lib/sanity/image';
import type { GallerySection as GallerySectionData } from '../../lib/sanity/queries';

interface Props {
  section: GallerySectionData;
  showMoreLink?: boolean;
}

const { section, showMoreLink = false } = Astro.props;
---

<section class="mx-auto w-full max-w-[1440px] px-6 py-12 md:py-20">
  <div class="flex flex-col gap-8 md:gap-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2
        class="text-left font-sans text-[2.5rem] font-light leading-[1.1] tracking-[-0.03em] text-mandalay-950 max-md:text-[2rem]"
      >
        {section.heading}
      </h2>
      {
        showMoreLink && (
          <Button variant="text-only" href="/galeria" arrow>
            További képek
          </Button>
        )
      }
    </div>

    <div class="columns-2 gap-4 md:columns-4 md:gap-6">
      {
        section.images.map((item) => {
          const imageSrc = item.image
            ? buildImageUrl(item.image, { width: 600 })
            : item.fallbackImageUrl ?? '';

          const caption = item.alt?.trim() ?? '';

          return (
            <div class="relative mb-4 w-full break-inside-avoid overflow-hidden rounded-[12px] md:mb-6">
              <img
                src={imageSrc}
                alt={caption}
                loading="lazy"
                decoding="async"
                class="h-auto w-full"
              />
              {caption && (
                <span
                  aria-hidden="true"
                  class="absolute bottom-2 left-2 max-w-[calc(100%-1rem)] rounded-[0.3rem] bg-mako-50 px-2 py-1 text-[0.75rem] leading-none text-mandalay-950"
                >
                  {caption}
                </span>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
