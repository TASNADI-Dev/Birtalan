---
import Button from '../Button.astro';
import { asset } from '../../lib/assets';
import { renderHeadingHtml } from '../../lib/sanity/renderHeading';
import type { HeroSection as HeroSectionData } from '../../lib/sanity/queries';

interface Props {
  section: HeroSectionData;
}

const { section } = Astro.props;
const headingHtml = renderHeadingHtml(section.heading);
---

<section class="mx-auto w-full max-w-[1440px] px-6 py-12 md:py-20">
  <div class="grid items-center gap-10 md:grid-cols-2 md:gap-16 xl:gap-24">
    <div class="flex flex-col gap-6 md:gap-8">
      <p
        class="flex flex-wrap items-center gap-x-2 font-heading text-[0.875rem] italic leading-none tracking-[-0.01em] text-mandalay-800"
      >
        {
          section.eyebrow.map((tag, index) => (
            <>
              {index > 0 && <span aria-hidden="true">·</span>}
              <span>{tag}</span>
            </>
          ))
        }
      </p>

      <div class="flex flex-col gap-3">
        <h1
          class="font-sans text-[3.5rem] font-light leading-[1.1] tracking-[-0.03em] text-mandalay-950"
          set:html={headingHtml}
        />

        <p
          class="max-w-[32rem] text-[0.875rem] leading-[1.5] tracking-[-0.01em] text-mako-700"
        >
          {section.description}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <Button variant="large" href="/kapcsolat" arrow>
          {section.buttonLabel}
        </Button>
      </div>
    </div>

    <div class="relative w-full overflow-hidden rounded-[12px]">
      <img
        src={asset('home/hero.webp')}
        alt="BI-EM Beauty szalon belső tere"
        width="720"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[4/5] w-full object-cover md:aspect-auto md:h-full md:min-h-[28rem]"
      />
    </div>
  </div>
</section>
