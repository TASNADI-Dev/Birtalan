---
import { buildImageUrl } from '../../lib/sanity/image';
import { asset } from '../../lib/assets';
import { renderPortableTextHtml } from '../../lib/sanity/renderPortableText';
import type { PageHeroSection as PageHeroSectionData } from '../../lib/sanity/queries';

interface Props {
  section: PageHeroSectionData;
}

const { section } = Astro.props;

const imageSrc = section.imageUrl
  ? buildImageUrl(section.imageUrl, { width: 800, height: 800 })
  : section.fallbackImageUrl ?? asset('home/hero.webp');
const descriptionHtml = renderPortableTextHtml(section.description);
---

<section class="mx-auto w-full max-w-[1440px] px-6 py-20 max-md:py-12">
  <div
    class="grid grid-cols-2 items-center gap-16 xl:gap-24 max-md:grid-cols-1 max-md:gap-10"
  >
    <div class="flex flex-col gap-3">
      <h1
        class="font-sans text-[3.5rem] font-light leading-[1.1] tracking-[-0.03em] text-mandalay-950 max-md:text-[2.5rem]"
      >
        {section.heading}
      </h1>
      {
        descriptionHtml && (
          <div
            class="flex max-w-[32rem] flex-col gap-3 text-[0.875rem] leading-[1.5] tracking-[-0.01em] text-mako-700 [&_a]:text-highlight [&_a]:underline [&_a]:underline-offset-2 [&_ol]:list-decimal [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:pl-5"
            set:html={descriptionHtml}
          />
        )
      }
    </div>

    <div class="relative w-full overflow-hidden rounded-[12px]">
      <img
        src={imageSrc}
        alt={section.alt ?? ''}
        width="800"
        height="800"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-square w-full object-cover"
      />
    </div>
  </div>
</section>
