---
import GallerySection from './GallerySection.astro';
import HeroSection from './HeroSection.astro';
import PageHeroSection from './PageHeroSection.astro';
import SplitSection from './SplitSection.astro';
import type { PageSection } from '../../lib/sanity/queries';

interface Props {
  sections: PageSection[];
}

const { sections } = Astro.props;
---

{
  sections.map((section) => {
    switch (section._type) {
      case 'heroSection':
        return <HeroSection section={section} />;
      case 'pageHeroSection':
        return <PageHeroSection section={section} />;
      case 'splitSection':
        return <SplitSection section={section} />;
      case 'gallerySection':
        return <GallerySection section={section} />;
      default:
        return null;
    }
  })
}
