---
import Button from '../Button.astro';
import { buildImageUrl } from '../../lib/sanity/image';
import type { SplitSection as SplitSectionData } from '../../lib/sanity/queries';

interface Props {
  section: SplitSectionData;
}

const { section } = Astro.props;

const imageSrc = section.imageUrl
  ? buildImageUrl(section.imageUrl, { width: 800, height: 800 })
  : section.fallbackImageUrl ?? '';
const isReversed = section.variant === 'text-image';
const buttonLabel = section.buttonLabel ?? 'Részletek';
---

<section class="mx-auto w-full max-w-[1440px] px-6 py-12 md:py-20">
  <div class="grid grid-cols-2 items-center gap-16 xl:gap-24 max-md:grid-cols-1 max-md:gap-10">
    <div
      class:list={[
        'relative w-full overflow-hidden rounded-[12px]',
        isReversed && 'order-2 max-md:order-first',
      ]}
    >
      <img
        src={imageSrc}
        alt={section.alt ?? ''}
        width="800"
        height="800"
        loading="lazy"
        decoding="async"
        class="aspect-square w-full object-cover"
      />
    </div>

    <div
      class:list={[
        'flex flex-col gap-6 md:gap-8',
        isReversed && 'order-1 max-md:order-last',
      ]}
    >
      <div class="flex flex-col gap-3">
        <h2
          class="font-sans text-[2.5rem] font-light leading-[1.1] tracking-[-0.03em] text-mandalay-950 max-md:text-[2rem]"
        >
          {section.heading}
        </h2>
        <p
          class="max-w-[32rem] text-[0.875rem] leading-[1.5] tracking-[-0.01em] text-mako-700"
        >
          {section.paragraph}
        </p>
      </div>
      {
        section.buttonHref && (
          <div>
            <Button variant="text-only" href={section.buttonHref} arrow>
              {buttonLabel}
            </Button>
          </div>
        )
      }
    </div>
  </div>
</section>
