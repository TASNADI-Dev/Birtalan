---
import Button from '../Button.astro';
import { asset } from '../../lib/assets';
import { buildImageUrl } from '../../lib/sanity/image';
import type { TemplatePage } from '../../lib/sanity/queries';

interface Props {
  hero: TemplatePage['hero'];
}

const { hero } = Astro.props;

const imageSrc = hero.imageUrl
  ? buildImageUrl(hero.imageUrl, { width: 1440, height: 1800 })
  : hero.fallbackImageUrl ?? asset('home/hero.webp');
---

<section class="mx-auto w-full max-w-[1440px] px-6 py-12 md:py-20">
  <div class="grid items-center gap-10 md:grid-cols-2 md:gap-16 xl:gap-24">
    <div class="flex flex-col gap-6 md:gap-8">
      <div class="flex flex-col gap-3">
        <h1
          class="font-sans text-[3.5rem] font-light leading-[1.1] tracking-[-0.03em] text-mandalay-950"
        >
          {hero.heading}
        </h1>

        <p
          class="max-w-[32rem] text-[0.875rem] leading-[1.5] tracking-[-0.01em] text-mako-700"
        >
          {hero.description}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <Button variant="large" href="/kapcsolat" arrow>
          Időpontfoglalás
        </Button>
        <Button variant="text-only" href="#">
          Részletek
        </Button>
      </div>
    </div>

    <div class="relative w-full overflow-hidden rounded-[12px]">
      <img
        src={imageSrc}
        alt={hero.alt ?? ''}
        width="720"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[4/5] w-full object-cover md:aspect-auto md:h-full md:min-h-[28rem]"
      />
    </div>
  </div>
</section>
