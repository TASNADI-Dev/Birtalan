---
import type { TestimonialSection as TestimonialSectionData } from '../../lib/sanity/queries';

interface Props {
  section: TestimonialSectionData;
}

const { section } = Astro.props;
const testimonials = section.testimonials ?? [];
---

{
  testimonials.length > 0 && (
    <section class="mx-auto w-full max-w-[1440px] px-6 py-12 md:py-20">
      <div class="flex flex-col gap-8 md:gap-12">
        <h2 class="text-left font-sans text-[2.5rem] font-light leading-[1.1] tracking-[-0.03em] text-mandalay-950 max-md:text-[2rem]">
          Rólam mondták
        </h2>

        <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 md:gap-x-6 md:gap-y-12">
          {testimonials.map((testimonial) => (
            <li class="flex flex-col gap-4">
              <p class="text-[0.875rem] leading-[1.5] tracking-[-0.01em] text-mako-700 whitespace-pre-line">
                {testimonial.quote}
              </p>
              <p class="font-heading text-[1rem] italic leading-none tracking-[-0.01em] text-mandalay-800">
                {testimonial.name}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
