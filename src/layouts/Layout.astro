---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { asset } from "../lib/assets";

interface Props {
	title?: string;
}

const { title = "Astro" } = Astro.props;
---

<!doctype html>
<html lang="hu">
	<head>
		<meta charset="utf-8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href={asset("global/favicon.svg")} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-83QKD8FKET"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());
			gtag("config", "G-83QKD8FKET");
		</script>
		<!-- End Google tag (gtag.js) -->
	</head>
	<body class="flex min-h-svh flex-col pt-[4rem]">
		<Nav />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
