---
import Layout from "../layouts/Layout.astro";
import PageSections from "../components/blocks/PageSections.astro";
import { defaultHomeSections } from "../lib/sanity/defaultHomePage";
import { getHomePage } from "../lib/sanity/queries";

const homePage = await getHomePage();
const sections =
	homePage?.sections?.length ? homePage.sections : defaultHomeSections;
---

<Layout title="Birtalan">
	<PageSections sections={sections} />
</Layout>
